  "hypotheses": [
    {
      "id": "h1",
      "statement": "画像分類において、ラベルスムージング（α=0.1）で学習した教師から低温度（T=1）で蒸留した生徒は、hard target で学習した教師から同条件で蒸留した生徒より較正が良い（期待較正誤差 ECE が低い）。",
      "assumptions": [
        "15-bin ECE が「較正の良さ」を代表する（c1）。",
        "CIFAR-100 と ResNet-18 教師 / 小型 CNN 生徒という 1 設定での差が、画像分類一般に外挿できる（c1）。",
        "hard target 教師からの蒸留が「較正を継承しない」側の代表的な基準になっている（c1）。",
        "seed 1 本の ECE 差 0.01 が run 間のばらつきより大きい（c1）。"
      ],
      "grounded_on": [
        "s1.p1",
        "s1.p2",
        "s3.p2",
        "s4.p1",
        "s4.p2"
      ],
      "claims": [
        {
          "id": "c1",
          "statement": "LS 教師から T=1 で蒸留した生徒の ECE は、hard 教師から T=1 で蒸留した生徒の ECE より 0.01 以上低い。",
          "rationale": "仮説そのものの測定である。教師の較正差（s1.p1）が蒸留を通じて生徒に現れるか（s4.p1）を、Chandrasegaran らが精度の面で推奨する T=1（s3.p2）で直接比較する。",
          "verifier": {
            "kind": "seyval"
          },
          "designs": [
            {
              "id": "d1",
              "summary": "CIFAR-100。各 run は教師（ResNet-18、hard または LS α=0.1）を学習し、その凍結 logit から小型 CNN 生徒を T=1、KL:CE=0.9:0.1 で蒸留し、テスト集合で生徒の ece / accuracy / nll と教師の teacher_ece / teacher_accuracy を出力する。教師の損失以外の全条件を共有する。",
              "runs": [
                {
                  "run_id": "student-hard",
                  "description": "hard target（α=0）教師 → T=1 蒸留",
                  "params": {
                    "mode": "full"
                  }
                },
                {
                  "run_id": "student-ls",
                  "description": "LS（α=0.1）教師 → T=1 蒸留",
                  "params": {
                    "mode": "full"
                  },
                  "cites_passages": [
                    "s3.p2"
                  ]
                }
              ],
              "cites_passages": [
                "s3.p2"
              ]
            }
          ],
          "cites_passages": [
            "s1.p1",
            "s3.p2",
            "s4.p1"
          ],
          "criterion": {
            "metric": "ece",
            "subject": "student-ls",
            "reference": "student-hard",
            "op": "<=",
            "margin": -0.01
          },
          "prediction": {
            "low": -0.04,
            "high": -0.01,
            "basis": "Müller らは CIFAR-100 で LS が教師の ECE を数ポイント下げると報告しており、その一部が生徒に継承されるという想定。"
          }
        }
      ],
